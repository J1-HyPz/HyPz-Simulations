# Copy to .env next to docker-compose.yml. Never commit the real file.
# Everything here is optional: with no key, lineups are skipped and the rest of
# the pipeline runs unchanged.

# --- Recommended: Highlightly -------------------------------------------------
# Free tier is 100 requests/day and, unlike API-Football, covers the CURRENT
# season - tiers differ only in request volume, not in features.
#   https://highlightly.net/football-api/
HIGHLIGHTLY_KEY=
# Optional. Left blank, the Premier League id is looked up once and cached.
HIGHLIGHTLY_LEAGUE_ID=

# --- Alternative: API-Football ------------------------------------------------
# Free tier reaches seasons 2022-2024 only, so it CANNOT serve current fixtures.
# Still useful for historical lineups.
#   https://dashboard.api-football.com
API_FOOTBALL_KEY=

# auto (default) prefers Highlightly, then API-Football.
# Force one with: highlightly | api_football
HYPZ_LINEUP_PROVIDER=auto
